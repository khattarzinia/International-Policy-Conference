# Local development only: never enable on a hosted deployment.
IPC_LOCAL_STORAGE=true
IPC_DATA_DIR=.local/ipc
IPC_ACCEPT_SUBMISSIONS=true
IPC_ORIGIN=http://localhost:4318
# Use unique, random values (at least 24 and 32 characters respectively).
IPC_ADMIN_PASSWORD=
IPC_SESSION_SECRET=

# Production: disable local storage and configure a dedicated Supabase project.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service-role JWT also supported; never publish either secret.
SUPABASE_SERVICE_ROLE_KEY=

# AI scanning stays disabled until explicitly enabled with an allowance.
IPC_ENABLE_AI_SCANS=false
IPC_MAX_SCANS_PER_DAY=0
IPC_AI_PROVIDER=local
# Own model service: HTTPS in production; localhost permitted in development.
IPC_AI_ENDPOINT=http://127.0.0.1:4319
IPC_MODEL_TOKEN=
IPC_MODEL_DIR=.local/ml-model
# Optional external providers are supported only when explicitly selected.
GPTZERO_API_KEY=
SAPLING_API_KEY=
